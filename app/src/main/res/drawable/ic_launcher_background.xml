<?xml version="1.0" encoding="utf-8"?>
<!--
  Visible light spectrum from red to violet, with red over-represented on the
  left. The gradient spans only the 72dp safe zone (18..90) of the 108dp
  adaptive icon canvas, so the proportions survive any launcher mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="54"
                android:endX="90"
                android:endY="54">
                <item android:offset="0.00" android:color="#FFFF0000" /> <!-- red -->
                <item android:offset="0.40" android:color="#FFFF0000" /> <!-- red -->
                <item android:offset="0.55" android:color="#FFFF8000" /> <!-- orange -->
                <item android:offset="0.64" android:color="#FFFFFF00" /> <!-- yellow -->
                <item android:offset="0.73" android:color="#FF00FF00" /> <!-- green -->
                <item android:offset="0.81" android:color="#FF00FFFF" /> <!-- cyan -->
                <item android:offset="0.90" android:color="#FF0000FF" /> <!-- blue -->
                <item android:offset="1.00" android:color="#FF8000FF" /> <!-- violet -->
            </gradient>
        </aapt:attr>
    </path>
</vector>

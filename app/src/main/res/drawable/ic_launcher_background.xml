<?xml version="1.0" encoding="utf-8"?>
<!--
  Color range from red through amber and yellow to white: blends from red
  to amber over 75%, to yellow over 18.75% and to white over 6.25%.
  The gradient spans only the 72dp safe zone (18..90) of the 108dp adaptive
  icon canvas, so the proportions survive any launcher mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="54"
                android:endX="90"
                android:endY="54">
                <item android:offset="0.00" android:color="#FFFF0000" /> <!-- red -->
                <item android:offset="0.7500" android:color="#FFFFBF00" /> <!-- amber -->
                <item android:offset="0.9375" android:color="#FFFFFF00" /> <!-- yellow -->
                <item android:offset="1.00" android:color="#FFFFFFFF" /> <!-- white -->
            </gradient>
        </aapt:attr>
    </path>
</vector>
